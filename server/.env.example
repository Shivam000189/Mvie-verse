# ==============================================================================
# Movie Discovery App — Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Client Origins for CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173

# Movie Provider Selection: use 'mock' locally, 'tmdb' in production
MOVIE_PROVIDER=mock

# PostgreSQL Database Connection (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=movie_app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movie_discovery_db?schema=public

# Gemini assistant configuration (optional; keep the key server-side)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# TMDB (The Movie Database) API Configuration (required when MOVIE_PROVIDER=tmdb)
# Option A (Recommended): TMDB v4 Read Access Token (Bearer token)
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# Option B: TMDB v3 API Key
TMDB_API_KEY=your_tmdb_v3_api_key_here

# TMDB Network & Image Endpoints
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_TIMEOUT_MS=8000

# ==============================================================================
# Rate Limiting Configuration (Configurable thresholds)
# ==============================================================================
# General API Rate Limiting (Default: 100 requests per 15 minutes per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Wishlist Mutation Rate Limiting (Default: 30 mutation requests per 1 minute per IP)
WISHLIST_RATE_LIMIT_WINDOW_MS=60000
WISHLIST_RATE_LIMIT_MAX_REQUESTS=30

# Auth Route Exponential Backoff Limits (For future login/signup endpoints)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=5
AUTH_BACKOFF_BASE_MS=1000

