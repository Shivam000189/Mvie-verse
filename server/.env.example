# ==============================================================================
# Movie Discovery App — Environment Configuration Template
# Copy this file to .env and provide your local credentials.
# NEVER commit .env to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=development
PORT=5000

# Client Origins for CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CLIENT_URL=http://localhost:5173

# Movie Provider Selection: 'mock' (default, offline) or 'tmdb' (live API)
MOVIE_PROVIDER=mock

# PostgreSQL Database Connection (Prisma ORM)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=movie_app
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movie_discovery_db?schema=public

# TMDB (The Movie Database) API Configuration (Required only when MOVIE_PROVIDER=tmdb)
# Option A (Recommended): TMDB v4 Read Access Token (Bearer token)
TMDB_ACCESS_TOKEN=your_tmdb_v4_read_access_token_here

# Option B: TMDB v3 API Key
TMDB_API_KEY=your_tmdb_v3_api_key_here

# TMDB Network & Image Endpoints
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_TIMEOUT_MS=8000
